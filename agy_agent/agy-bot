def manage_service(action: str, target: str):
    targets = []
    if target in ("all", "both"):
        targets = [AGY_SERVICE, SURFACE_SERVICE]
    elif target in ("agy", "agy-bot", "vibe"):
        targets = [AGY_SERVICE]
    elif target in ("surface", "status"):
        targets = [SURFACE_SERVICE]
    else:
        print(f"{RED}잘못된 대상입니다: {target}. (사용 가능: all, agy, surface){RESET}")
        return

    for s in targets:
        print(f"{CYAN}>> {action.upper()} {s}...{RESET}")
        subprocess.run(["systemctl", "--user", action, s])

    print(f"{GREEN}✓ 완료되었습니다.{RESET}\n")
    show_status()

def show_logs(target: str):
    service = AGY_SERVICE
    if target in ("surface", "status"):
        service = SURFACE_SERVICE

    print(f"{CYAN}>> {service} 실시간 로그 출력 (종료: Ctrl+C)...{RESET}\n")
    try:
        subprocess.run(["journalctl", "--user", "-u", service, "-f"])
    except KeyboardInterrupt:
        print("\n로그 확인을 종료했습니다.")

def list_channels():
    print(f"\n{BOLD}📂 현재 등록된 디스코드 채널 및 작업 공간:{RESET}\n")
    if not STATE_FILE.exists():
        print("등록된 채널이 없습니다.")
        return

    with open(STATE_FILE, "r", encoding="utf-8") as f:
        channels = json.load(f)

    for ch_id, data in channels.items():
        ws = data.get("workspace", "N/A")
        conv = data.get("conversation_id", "None")
        print(f"채널 ID: {BOLD}{ch_id}{RESET}")
        print(f"  └─ 작업 경로: {YELLOW}{ws}{RESET}")
        print(f"  └─ 대화 세션: {conv}\n")

def set_channel(ch_id_str: str, path_str: str):
    abs_path = str(Path(path_str).expanduser().resolve())
    os.makedirs(abs_path, exist_ok=True)

    data = {}
    if STATE_FILE.exists():
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

    ch_id = ch_id_str.strip()
    if ch_id not in data:
        data[ch_id] = {"conversation_id": None}

    data[ch_id]["workspace"] = abs_path

    os.makedirs(STATE_FILE.parent, exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)

    print(f"{GREEN}✓ 채널 {ch_id} 의 작업 경로가 설정되었습니다:{RESET}\n  ➔ {YELLOW}{abs_path}{RESET}")
    print(f"{CYAN}>> AGY 봇 서비스를 재시작합니다...{RESET}")
    subprocess.run(["systemctl", "--user", "restart", AGY_SERVICE])
    print(f"{GREEN}✓ 적용 완료되었습니다.{RESET}")

def reset_channel_session(ch_id_str: str):
    ch_id = ch_id_str.strip()
    if not STATE_FILE.exists():
        print("상태 파일이 없습니다.")
        return

    with open(STATE_FILE, "r", encoding="utf-8") as f:
        data = json.load(f)

    if ch_id in data:
        data[ch_id]["conversation_id"] = None
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        print(f"{GREEN}✓ 채널 {ch_id} 의 세션이 초기화되었습니다.{RESET}")
    else:
        print(f"{RED}채널 {ch_id} 을 찾을 수 없습니다.{RESET}")

