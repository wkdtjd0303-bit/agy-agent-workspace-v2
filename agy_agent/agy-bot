def main():
    args = sys.argv[1:]
    if not args:
        show_status()
        return

    cmd = args[0].lower()

    if cmd in ("status", "info"):
        show_status()
    elif cmd in ("restart", "start", "stop"):
        target = args[1].lower() if len(args) > 1 else "all"
        manage_service(cmd, target)
    elif cmd in ("logs", "log"):
        target = args[1].lower() if len(args) > 1 else "agy"
        show_logs(target)
    elif cmd in ("channels", "list", "ls"):
        list_channels()
    elif cmd in ("set", "set-channel", "cd"):
        if len(args) < 3:
            print(f"{RED}사용법: agy-bot set <채널ID> <작업경로>{RESET}")
            sys.exit(1)
        set_channel(args[1], args[2])
    elif cmd in ("reset", "reset-session"):
        if len(args) < 2:
            print(f"{RED}사용법: agy-bot reset <채널ID>{RESET}")
            sys.exit(1)
        reset_channel_session(args[1])
    elif cmd in ("help", "-h", "--help"):
        print_help()
    else:
        print(f"{RED}알 수 없는 명령어: {cmd}{RESET}")
        print_help()

if __name__ == "__main__":
    main()
