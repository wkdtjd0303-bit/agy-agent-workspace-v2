RESET = "\033[0m"

def get_service_status(service_name: str):
    res = subprocess.run(
        ["systemctl", "--user", "is-active", service_name],
        capture_output=True,
        text=True
    )
    is_active = res.stdout.strip() == "active"
    
    details = {}
    if is_active:
        res_info = subprocess.run(
            ["systemctl", "--user", "show", service_name, "--property=MainPID,ActiveEnterTimestamp,MemoryCurrent"],
            capture_output=True,
            text=True
        )
        for line in res_info.stdout.strip().split("\n"):
            if "=" in line:
                k, v = line.split("=", 1)
                details[k] = v
    return is_active, details

def format_memory(mem_bytes_str):
    try:
        b = int(mem_bytes_str)
        if b < 1024 * 1024:
            return f"{b / 1024:.1f} KB"
        return f"{b / (1024 * 1024):.1f} MB"
    except Exception:
        return "N/A"

