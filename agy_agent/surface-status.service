Environment="PATH=/home/jangsung/Desktop/autocoding/!5_agy_agent/agy_agent/.venv/bin:/home/jangsung/.npm-global/bin:/home/jangsung/.local/bin:/home/jangsung/.gemini/antigravity-cli/bin:/usr/local/bin:/usr/bin:/bin"
